{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://scen-backend.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|prompt-library.json|agent-studio).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/templates/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/prompt-library.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
