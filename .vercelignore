# The frontend project deploys only the static build from the repo root.
# The backend is a separate Vercel project rooted at backend/server-connector.
backend/
docs/
manifests/
node_modules/
.next/
*.command
ROADMAP-VERIFIED.md
START-HERE.txt

# Vercel uploads from the filesystem, not from git, so .gitignore does not
# protect anything here. ADMIN-KEY.txt is the staff key: without this line it
# would be served as a static file at /ADMIN-KEY.txt.
ADMIN-KEY.txt
*.key
.env
.env.*

# Internal notes. Not secret, but they document the staff login and every
# gated route, which is not something to hand to the public.
SITE-TREE.md
HANDOFF.md
README.md

# Local dev helper inside a template folder (Terranova ships as five files,
# one of which only exists to serve the other four on localhost). It stays in
# the repo; there is no reason to hand it to visitors.
templates/**/serve.mjs
