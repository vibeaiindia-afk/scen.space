# Scen admin session / connector security
SCEN_ADMIN_SESSION_SECRET=replace-with-at-least-24-random-characters
SCEN_USER_SESSION_SECRET=replace-with-at-least-24-random-characters
SCEN_CONNECTOR_ENCRYPTION_KEY=replace-with-long-random-encryption-secret
SCEN_VERCEL_CONNECTOR_ENABLED=true

# Vercel connector: OAuth recommended. Server token is fallback only.
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
VERCEL_ADMIN_TOKEN=

# AI provider secrets — keep server-side / Vercel only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Model configuration — editable without changing adapters
SCEN_OPENAI_MODEL=gpt-5.6
SCEN_ANTHROPIC_MODEL=claude-sonnet-4-5
SCEN_GEMINI_MODEL=gemini-3.5-flash
SCEN_GROK_MODEL=grok-4.6
# Override only if xAI changes its API host
SCEN_GROK_BASE_URL=https://api.x.ai/v1

# Feature routing
SCEN_AI_CHAT_PRIMARY=openai
SCEN_AI_CHAT_FALLBACK=anthropic
SCEN_AI_CODE_PRIMARY=openai
SCEN_AI_CODE_FALLBACK=anthropic
SCEN_AI_PLANNING_PRIMARY=anthropic
SCEN_AI_PLANNING_FALLBACK=openai
SCEN_AI_ANALYSIS_PRIMARY=gemini
SCEN_AI_ANALYSIS_FALLBACK=anthropic

# Hard technical request ceilings
SCEN_AI_TIMEOUT_MS=45000
SCEN_AI_MAX_INPUT_CHARS=120000
SCEN_AI_MAX_OUTPUT_TOKENS=4096

# LOCAL DEVELOPMENT ONLY — never enable in production
SCEN_AI_ALLOW_DEV_ANON=false

# Image generation provider secrets — server-side only
REPLICATE_API_TOKEN=

# Image models (OpenAI/Gemini reuse their existing provider keys)
SCEN_OPENAI_IMAGE_MODEL=gpt-image-2
SCEN_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
SCEN_REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# Image provider routing
SCEN_IMAGE_PRIMARY=openai
SCEN_IMAGE_FALLBACK=gemini
SCEN_IMAGE_RESCUE=replicate
SCEN_IMAGE_FALLBACKS=true
SCEN_IMAGE_ENABLE_RESCUE=false

# Image request ceilings
SCEN_IMAGE_TIMEOUT_MS=150000
SCEN_IMAGE_MAX_PROMPT_CHARS=12000
SCEN_IMAGE_MAX_COUNT=4
SCEN_IMAGE_MAX_REFERENCES=6
SCEN_IMAGE_MAX_REFERENCE_BYTES=8388608

# provider = rely on provider-native safety; openai = pre-check prompt with omni-moderation-latest
SCEN_IMAGE_MODERATION_MODE=provider

# Optional storage ingestion hook. If blank, normalized base64/remote URL is returned to caller.
SCEN_ASSET_INGEST_URL=
SCEN_ASSET_INGEST_TOKEN=
SCEN_IMAGE_STORAGE_REQUIRED=false
SCEN_IMAGE_RETURN_BASE64=false

# Scen Video Gateway
SCEN_VIDEO_JOB_SECRET=replace-with-32-plus-random-chars
SCEN_OPENAI_VIDEO_MODEL=sora-2
SCEN_GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
SCEN_REPLICATE_VIDEO_MODEL=google/veo-3
SCEN_GROK_VIDEO_MODEL=grok-imagine-video-1.5
SCEN_VIDEO_PRIMARY=gemini
SCEN_VIDEO_FALLBACK=openai
SCEN_VIDEO_RESCUE=replicate
SCEN_VIDEO_FALLBACKS=true
SCEN_VIDEO_RESCUE_ENABLED=false
SCEN_VIDEO_MAX_PROMPT_CHARS=20000
SCEN_VIDEO_MAX_REFERENCES=3
SCEN_VIDEO_MAX_REFERENCE_MB=12
SCEN_VIDEO_PROVIDER_TIMEOUT_MS=45000
SCEN_VIDEO_PROMPT_MODERATION=provider
SCEN_VIDEO_STORAGE_MODE=passthrough

# --- Database + Storage Foundation ---
DATABASE_URL=
DATABASE_SSL=require
SCEN_DB_MAX_CONNECTIONS=5
SCEN_DB_CONNECT_TIMEOUT_SECONDS=10
SCEN_STORAGE_SIGNING_SECRET=replace-with-32-plus-random-characters
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=
SCEN_STORAGE_SIGN_TTL_SECONDS=600
SCEN_ASSET_MAX_UPLOAD_MB=25
SCEN_PROJECT_TRASH_DAYS=30
SCEN_ASSET_TRASH_DAYS=14
SCEN_BACKUP_RPO_HOURS=24
SCEN_BACKUP_RTO_HOURS=4


# --- Payments + Credits ---
SCEN_BILLING_PRIMARY_IN=dodo
SCEN_BILLING_PRIMARY_GLOBAL=stripe
SCEN_BILLING_WEBHOOK_TOLERANCE_SECONDS=300
SCEN_CREDIT_LOW_BALANCE=200
SCEN_CREDIT_RESERVATION_TTL_MINUTES=30
SCEN_FAILED_PAYMENT_GRACE_DAYS=3

# Dodo Payments — server only
# DODO_ENV: test (default) or live. Keys differ between the two.
DODO_ENV=test
DODO_API_KEY=
# Standard Webhooks secret from the Dodo dashboard (starts with whsec_).
# Register https://your-domain.com/api/billing/webhooks/dodo as the endpoint.
DODO_WEBHOOK_SECRET=
# Recurring products created once in the Dodo dashboard (one per plan) —
# subscriptions can't use Pay What You Want, so each plan's price lives there.
DODO_PRODUCT_BASIC=
DODO_PRODUCT_PLUS=
DODO_PRODUCT_PRO=
DODO_PRODUCT_PREMIUM=
# One-time products created once in the Dodo dashboard with "Pay What You
# Want" enabled — every checkout passes the exact amount from our own config,
# so the dashboard price is only a ceiling.
DODO_PRODUCT_TOPUP=
DODO_PRODUCT_STORE=

# Razorpay — server only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_CREATOR=
RAZORPAY_PLAN_PRO=

# Stripe — server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled

# Optional public product checkout return URLs
SCEN_BILLING_SUCCESS_URL=http://localhost:3000/billing?checkout=success
SCEN_BILLING_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled

# Authentication + Transactional Email
SCEN_AUTH_SESSION_DAYS=30
SCEN_AUTH_VERIFY_MINUTES=60
SCEN_AUTH_RESET_MINUTES=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SCEN_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
SCEN_APP_URL=http://localhost:3000
SCEN_EMAIL_PROVIDER=resend
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SCEN_EMAIL_FROM=Scen <no-reply@scen.space>
SCEN_EMAIL_REPLY_TO=support@scen.space
SCEN_EMAIL_NOTIFY_GENERATIONS=false
SCEN_EMAIL_TEST_TO=
